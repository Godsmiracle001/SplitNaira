# Docker Compose settings for a LOCAL / TESTNET stack.
# Copy to .env.local and run:  docker compose --env-file .env.local up --build
# These are development values only. Never reuse them in production.

# --- Database (local container) ---
DB_USER=splitnaira
DB_PASSWORD=change-me-local-only
DB_NAME=splitnaira
DB_PORT=5432

# --- Backend ---
NODE_ENV=production
PORT=3001
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
LOG_FORMAT=pretty
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# REQUIRED. The backend refuses to start without these, and the frontend waits
# for a healthy backend. The values below are the shared testnet deployment
# recorded in contracts/deployments.json. Replace them if you deploy your own.
#   CONTRACT_ID:        the deployed contract address (C..., 56 chars, must checksum)
#   SIMULATOR_ACCOUNT:  any funded testnet account (G...) used as the source for
#                       read-only simulations; it never signs anything.
CONTRACT_ID=CDSZJOB3ACD7GJDILCFTHSP3WRTJUC2GWZLJVOEUNTIVM2N6O25LEYWJ
SIMULATOR_ACCOUNT=GCJUMMG4VQA53NBJWJTAR55MNNQEW4QFPORLDAILVTGEP4JACZBBN5BN

# --- Frontend (baked into browser JavaScript at build time) ---
# Must be reachable FROM THE BROWSER, so use the published host port,
# not the internal Docker service name.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_CONTRACT_ID=CDSZJOB3ACD7GJDILCFTHSP3WRTJUC2GWZLJVOEUNTIVM2N6O25LEYWJ
FRONTEND_PORT=3000
